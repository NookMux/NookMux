{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "serena": {
      "type": "remote",
      "url": "http://127.0.0.1:9121/mcp",
      "timeout": 12000,
      "enabled": true
    },
    "codegraph": {
      "type": "local",
      "command": [
        "/usr/local/bin/codegraph",
        "serve",
        "--mcp",
        "--path",
        "."
      ],
      "timeout": 12000,
      "enabled": true
    }
  }
}